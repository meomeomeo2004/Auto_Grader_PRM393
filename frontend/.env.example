# Sao chép thành .env.local rồi chỉnh theo môi trường của bạn.

# VAI của bản đang chạy — quyết định menu và các màn hình được phép mở.
#   gv  = giảng viên : Bộ chấm Golden, Khung năng lực, Thư viện chấm   (cổng 3100 / 8090)
#   nc  = người chấm : Chấm tự động, Lịch sử chấm, Thư viện chấm       (cổng 3000 / 8080)
#   BẮT BUỘC — không còn bản thấy cả hai vai. Bỏ trống thì giao diện dừng lại và báo.
# Bản giao cho từng người do dong-goi.ps1 sinh ra và đã ghi sẵn dòng này.
NEXT_PUBLIC_ROLE=

# URL gốc của backend Spring Boot — phải khớp cổng của vai ở trên.
NEXT_PUBLIC_API_BASE=http://localhost:8080/api

# Mã đề thi điền sẵn trên form
NEXT_PUBLIC_DEFAULT_EXAM_ID=FLUTTER_PE_01

# Ngưỡng điểm đạt (hệ 10)
NEXT_PUBLIC_PASS_THRESHOLD=5
